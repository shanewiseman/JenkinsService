{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci.jenkinsservice.dev/schemas/pipeline-v1.schema.json",
  "title": "JenkinsService Pipeline Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "runtime", "steps"],
  "properties": {
    "apiVersion": {
      "const": "ci.jenkinsservice.dev/v1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+\\-]*@sha256:[a-f0-9]{64}$"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        },
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8,
          "default": 2
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$",
          "default": "2Gi"
        },
        "pids": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 512
        },
        "network": {
          "enum": ["none", "egress"],
          "default": "none"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "default": {}
        }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standards", "tests"],
      "properties": {
        "standards": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "custom": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"},
          "default": []
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitleaks": {"type": "boolean", "default": true},
        "trivy": {"type": "boolean", "default": true}
      },
      "default": {}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "path": {"$ref": "#/$defs/relativePath"},
          "required": {"type": "boolean", "default": false}
        }
      },
      "default": []
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "action": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,62}$"},
          "required": {"type": "boolean", "default": false}
        }
      },
      "default": []
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "(^|/)\\.\\.(/|$)"},
          {"pattern": "\\\\"}
        ]
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"enum": ["junit", "sarif", "coverage", "cyclonedx"]},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "command": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 8192},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"type": "string", "maxLength": 4096}
            }
          ]
        },
        "workingDirectory": {
          "$ref": "#/$defs/relativePath",
          "default": "."
        },
        "required": {"type": "boolean", "default": true},
        "timeoutMinutes": {"type": "integer", "minimum": 1, "maximum": 120},
        "environment": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
          "additionalProperties": {"type": "string", "maxLength": 4096},
          "default": {}
        },
        "reports": {
          "type": "array",
          "items": {"$ref": "#/$defs/report"},
          "default": []
        }
      }
    }
  }
}
