PUBLIC_BASE_URL=https://jenkins.shanewiseman.co
JENKINS_PUBLIC_URL=https://jenkins.shanewiseman.co/jenkins/
JENKINS_HOST=jenkins.shanewiseman.co
DMZ_NETWORK=dmz_internal
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=myresolver
JENKINS_URL=http://jenkins:8080/jenkins/
JENKINS_USER=jenkinsservice
JENKINS_TOKEN_FILE=/run/secrets/jenkins_api_token
DATABASE_URL=postgresql://jenkinsservice@postgres:5432/jenkinsservice
DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
API_TOKENS_FILE=/run/secrets/api_tokens
GITHUB_READ_TOKEN_FILE=/run/secrets/github_read_pat
GITHUB_WRITE_TOKEN_FILE=/run/secrets/github_write_pat
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_ALLOWLIST=shanewiseman/j-link_mcp
EXTENSION_ALLOWLIST=
EXTENSION_RUNNER_URL=http://extension-runner:8090
REVIEW_BROKER_URL=http://review-broker:8100
BUILD_CALLBACK_SECRET_FILE=/run/secrets/build_callback_secret
REVIEW_BROKER_TOKEN_FILE=/run/secrets/review_broker_token
BUILD_CALLBACK_MAX_AGE_SECONDS=300
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=0.25
REVIEW_PROMPT_VERSION=v1
REVIEW_MAX_DIFF_BYTES=250000
REVIEW_MAX_CONTEXT_BYTES=50000
REVIEW_MAX_OUTPUT_BYTES=64000
TRUST_PROXY_HEADERS=true
REQUIRE_HTTPS=true
ALLOWED_ORIGINS=https://jenkins.shanewiseman.co
RATE_LIMIT_PER_MINUTE=120
