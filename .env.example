PUBLIC_BASE_URL=https://ci.example.com
JENKINS_URL=http://jenkins:8080
JENKINS_USER=jenkinsservice
JENKINS_TOKEN_FILE=/run/secrets/jenkins_api_token
DATABASE_URL=postgresql://jenkinsservice@postgres:5432/jenkinsservice
DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
API_TOKENS_FILE=/run/secrets/api_tokens
GITHUB_READ_TOKEN_FILE=/run/secrets/github_read_pat
GITHUB_WRITE_TOKEN_FILE=/run/secrets/github_write_pat
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_ALLOWLIST=example-org/*
EXTENSION_ALLOWLIST=
EXTENSION_RUNNER_URL=http://extension-runner:8090
TRUST_PROXY_HEADERS=true
REQUIRE_HTTPS=true
ALLOWED_ORIGINS=https://ci.example.com
RATE_LIMIT_PER_MINUTE=120
